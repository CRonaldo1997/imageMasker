# ===== 内网跑批配置（Ubuntu + vLLM 本地部署 qwen3.8-27b）=====
# 用法：cp .env.production.example .env.production，按下行实际地址修改
#       IMAGE_MASK_ENV_FILE=.env.production python main.py /data/folder1
#
# vLLM 启动参考（Qwen3 系列，关闭思考模式由本工具通过 extra_body 控制）：
#   vllm serve /models/qwen3.8-27b \
#        --served-model-name qwen3.8-27b \
#        --port 8000 --max-model-len 16384 \
#        --limit-mm-per-prompt image=4
#
# 兼容性说明：
# - 若 vLLM 版本较旧、不认识 chat_template_kwargs，首次调用会报错，
#   工具会自动去掉 extra_body 降级重试（日志有 warning），无需人工干预；
#   也可直接设 VLM_ENABLE_THINKING=true 跳过该参数
# - limit-mm-per-prompt 必须 >= 2（质检会同时传原图+脱敏图两张）
# - max-model-len 建议 >= 16384（结构化 JSON 输出较长）

VLM_BASE_URL=http://127.0.0.1:8000/v1
VLM_MODEL=qwen3.8-27b
# vLLM 未设 --api-key 时不校验，任意非空占位即可；
# 若 vLLM 启动时指定了 --api-key xxx，这里必须填 xxx
VLM_API_KEY=EMPTY

VLM_TEMPERATURE=0.0
VLM_ENABLE_THINKING=false
VLM_MAX_IMAGE_SIDE=1024
VLM_MAX_TOKENS=4096
# 单次调用超时（秒）。本地 27B 推理慢于云 API，不建议低于 600
VLM_TIMEOUT=600

# ===== OCR 引擎 =====
OCR_ENGINE=rapid

# 全局方向矫正（Ubuntu 需 pip install rapid-orientation）
OCR_ORIENTATION_CORRECT=true

# ===== 脱敏 =====
DEFAULT_METHOD=white_mask
MASK_PADDING=3
MASK_COLOR=255,255,255
TEXT_COLOR=0,0,0
FAKE_DATA_ENABLED=true
FAKE_FONT_SIZE_RATIO=0.8
OUTPUT_DIR=outputs
DETECT_QR_CODES=true

# ===== 质检 =====
QA_MIN_MATCH_LEN=4
QA_MIN_DIGITS=8

# ===== Ubuntu 系统依赖（apt）=====
#   sudo apt install -y libgl1 libglib2.0-0 fonts-noto-cjk
# libgl1：opencv 运行所需；fonts-noto-cjk：假数据重绘中文字体
