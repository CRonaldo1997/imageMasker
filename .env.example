# ===== VLM 配置（OpenAI 兼容协议）=====
# 开发阶段：ModelScope API-Inference（外网）
VLM_BASE_URL=https://api-inference.modelscope.cn/v1
VLM_MODEL=Qwen/Qwen3.8-27B
VLM_API_KEY=your-modelscope-token

# Qwen3 系列务必关闭思考模式，否则结构化输出不稳定
VLM_ENABLE_THINKING=false
VLM_TEMPERATURE=0.0
VLM_MAX_IMAGE_SIDE=1024
VLM_MAX_TOKENS=4096
# 质检时「当前脱敏图」的长边上限（vision token 按面积计，512≈1024 的 1/4 成本）。
# 质检只需判断遮罩位置与文字是否消失；0 = 跟随 VLM_MAX_IMAGE_SIDE
VLM_QA_MASK_IMAGE_SIDE=512

# 上线阶段：切换为内网 vLLM 部署，只改下面三项，代码不动
# （完整内网模板见 .env.production.example；也可用
#   IMAGE_MASK_ENV_FILE=.env.production python main.py ... 切换配置文件）
# VLM_BASE_URL=http://your-internal-host:8000/v1
# VLM_MODEL=qwen3.8-27b
# VLM_API_KEY=EMPTY

# ===== OCR 引擎 =====
# rapid（默认，轻量纯 pip）| paddle（精度更高，需 py311）
OCR_ENGINE=rapid

# 全局方向矫正（需 pip install rapid-orientation）：
# 非 0° 时转正后 OCR，坐标逆变换回原图；默认关闭——
# RapidOCR 对竖排文本本就鲁棒，开启可多检出少量块
OCR_ORIENTATION_CORRECT=false

# ===== 脱敏 =====
# white_mask：白底覆盖后重绘等长假数据（推荐，保留业务含义）
# blur / mosaic：直接模糊/马赛克，不重绘假数据
DEFAULT_METHOD=white_mask
MASK_PADDING=3
MASK_COLOR=255,255,255
TEXT_COLOR=0,0,0
FAKE_DATA_ENABLED=true
FAKE_FONT_SIZE_RATIO=0.8
BLUR_RADIUS=12
MOSAIC_FACTOR=16
OUTPUT_DIR=outputs

# ===== 质检 =====
QA_MIN_MATCH_LEN=4
QA_MIN_DIGITS=8
# 质检重 OCR 的长边上限：该轮只做文字比对（残留/正则），不产出坐标，
# 大图先缩小再识别可省 10~20% OCR 耗时；0 = 不缩放
QA_REOCR_MAX_SIDE=1280
# 质检预检（重 OCR + 正则 + 几何误伤）放后台线程，与 VLM 语义质检同时跑：
# verify 从「重OCR + VLM」变成「max(重OCR, VLM)」，单张省 ~1.2~1.5s。
# false = 串行执行，并且给 VLM 带上预检 hints（仅供参考的上下文）
QA_PRECHECK_BACKGROUND=true
